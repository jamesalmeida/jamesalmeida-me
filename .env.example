# Copy to .env.local and fill in your keys.
# In production, set these in Vercel → Project → Settings → Environment Variables.
#
# NEVER prefix secrets with NEXT_PUBLIC_ and never list them under next.config `env`
# — both expose values to the browser bundle.

# OpenAI API Key (required: the default model is gpt-5.4) — server-only
OPENAI_API_KEY=sk-...

# Anthropic API Key (required only for Claude models) — server-only
ANTHROPIC_API_KEY=sk-ant-...

# Default model (optional). One of: gpt-5.4, claude-sonnet-5-5, gpt-4o, gpt-4o-mini.
# Unset or unknown values fall back to gpt-5.4.
# Server-only; not a secret, but no need to ship it to the client.
# DEFAULT_MODEL=gpt-5.4

# Admin password for model switching panel — server-only
ADMIN_PASSWORD=your-secure-password

# Optional HMAC key for the admin model cookie — server-only.
# Generate with: openssl rand -base64 32
# If unset, ADMIN_PASSWORD is used as the key.
# ADMIN_COOKIE_SECRET=
