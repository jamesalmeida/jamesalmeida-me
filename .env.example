# Copy to .env.local and fill in your keys.
# In production, set these in Vercel → Project → Settings → Environment Variables.
#
# NEVER prefix secrets with NEXT_PUBLIC_ and never list them under next.config `env`
# — both expose values to the browser bundle.

# OpenAI API Key (optional - for GPT models) — server-only
OPENAI_API_KEY=sk-...

# Anthropic API Key (required for Claude models) — server-only
ANTHROPIC_API_KEY=sk-ant-...

# Default model (claude-sonnet-4-5, claude-3-5-haiku-latest, gpt-4o, gpt-4o-mini)
# Server-only; not a secret, but no need to ship it to the client.
DEFAULT_MODEL=claude-sonnet-4-5

# Admin password for model switching panel — server-only
ADMIN_PASSWORD=your-secure-password
