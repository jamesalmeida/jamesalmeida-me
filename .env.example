# Copy to .env.local and fill in your keys.
# In production, set these in Vercel → Project → Settings → Environment Variables.
#
# NEVER prefix secrets with NEXT_PUBLIC_ and never list them under next.config `env`
# — both expose values to the browser bundle.

# OpenAI API Key (required: the default model is gpt-5.4) — server-only
OPENAI_API_KEY=sk-...

# Anthropic API Key (required only for Claude models) — server-only
ANTHROPIC_API_KEY=sk-ant-...

# Default model (optional). One of: gpt-5.4, claude-sonnet-5-5, gpt-4o, gpt-4o-mini.
# Unset or unknown values fall back to gpt-5.4.
# Server-only; not a secret, but no need to ship it to the client.
# DEFAULT_MODEL=gpt-5.4

# Admin password for model switching panel — server-only
ADMIN_PASSWORD=your-secure-password

# Optional HMAC key for the admin model cookie — server-only.
# Generate with: openssl rand -base64 32
# If unset, ADMIN_PASSWORD is used as the key.
# ADMIN_COOKIE_SECRET=

# Convex (analytics, transcripts, feedback, leads, site settings) — server-only.
# Without a deployment URL and CONVEX_SERVER_SECRET nothing is stored (fine for local dev and CI).
# CONVEX_URL is the deployment origin (https://<name>.convex.cloud). No trailing slash.
# CONVEX_SERVER_SECRET must match the same variable on that Convex deployment.
# Generate with: openssl rand -base64 32
# CONVEX_URL=
# CONVEX_SERVER_SECRET=
# `npm run build` deploys convex/ when CONVEX_DEPLOY_KEY is set (scripts/build.mjs).
# Vercel Production: a production deploy key, plus CONVEX_URL and CONVEX_SERVER_SECRET.
# Vercel Preview: a preview deploy key (not the production one) and CONVEX_SERVER_SECRET.
# Leave CONVEX_URL unset on Preview. The build bakes that preview's own URL.
# Set the same secret as a Convex project default for preview deployments first.
# CONVEX_DEPLOY_KEY=

# Optional: email James when someone leaves their email on the brief card (Resend).
# LEAD_NOTIFY_FROM must be a sender on a domain verified in Resend.
# RESEND_API_KEY=
# LEAD_NOTIFY_FROM=Skaffen <skaffen@gsv.to>
# LEAD_NOTIFY_TO=james@gsv.to
